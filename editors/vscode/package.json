{
  "name": "nullscan",
  "displayName": "Nullscan",
  "description": "TypeScript static analysis powered by the nullscan language server.",
  "version": "0.1.0-beta.1",
  "publisher": "bytezer",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/bytezer/nullscan.git"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Linters"
  ],
  "keywords": [
    "typescript",
    "linter",
    "static analysis",
    "nullscan"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:typescriptreact"
  ],
  "contributes": {
    "commands": [
      {
        "command": "nullscan.analyzeWorkspace",
        "title": "Analyze Workspace",
        "category": "Nullscan"
      },
      {
        "command": "nullscan.showSummary",
        "title": "Show Summary",
        "category": "Nullscan"
      },
      {
        "command": "nullscan.refreshIssues",
        "title": "Refresh Issues",
        "category": "Nullscan",
        "icon": "$(refresh)"
      },
      {
        "command": "nullscan.openConfig",
        "title": "Open Config",
        "category": "Nullscan"
      },
      {
        "command": "nullscan.redownloadServer",
        "title": "Redownload Server",
        "category": "Nullscan"
      },
      {
        "command": "nullscan.restartServer",
        "title": "Restart Server",
        "category": "Nullscan"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nullscan",
          "title": "Nullscan",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "nullscan": [
        {
          "id": "nullscan.byRule",
          "name": "By Rule"
        },
        {
          "id": "nullscan.byFile",
          "name": "By File"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "nullscan.byRule",
        "contents": "No issues found.\n[Run Analyze workspace](command:nullscan.analyzeWorkspace)"
      },
      {
        "view": "nullscan.byFile",
        "contents": "No issues found.\n[Run Analyze workspace](command:nullscan.analyzeWorkspace)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "nullscan.refreshIssues",
          "when": "view == nullscan.byRule",
          "group": "navigation"
        },
        {
          "command": "nullscan.refreshIssues",
          "when": "view == nullscan.byFile",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Nullscan",
      "properties": {
        "nullscan.path": {
          "type": "string",
          "default": "",
          "description": "Path to the nullscan-lsp executable. When empty, the extension uses a bundled binary in bin/<platform>-<arch>/, otherwise it downloads and verifies the matching release into global storage, and only then falls back to PATH."
        },
        "nullscan.configPath": {
          "type": "string",
          "default": "",
          "description": "Path to one nullscan.toml used for every file and every workspace scan. A relative path is resolved against the first workspace folder. When empty, the server reads nullscan.toml from each workspace folder."
        },
        "nullscan.analyzeOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "Analyze a document when it is opened."
        },
        "nullscan.analyzeOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Analyze a document when it is saved."
        },
        "nullscan.analyzeOnType": {
          "type": "boolean",
          "default": false,
          "description": "Analyze a document shortly after it changes. Off by default."
        },
        "nullscan.includeDuplicates": {
          "type": "boolean",
          "default": true,
          "description": "Include duplicate-code findings in workspace scans."
        },
        "nullscan.maxDiagnostics": {
          "type": "number",
          "default": 5000,
          "minimum": 1,
          "description": "Maximum number of diagnostics a workspace scan may report."
        },
        "nullscan.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the Nullscan status bar item."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pretest:integration": "node esbuild.mjs",
    "test:integration": "vscode-test",
    "package": "vsce package"
  },
  "dependencies": {
    "https-proxy-agent": "^9.1.0",
    "vscode-languageclient": "^11.0.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.91.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.2",
    "vitest": "^5.1.0"
  }
}
